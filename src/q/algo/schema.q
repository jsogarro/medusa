/ ============================================================================
/ schema.q - Execution Algorithm Schemas
/ ============================================================================
/ ----------------------------------------------------------------------------
/ Provides:
/   - algoOrder table: Parent algo orders (VWAP, TWAP, Iceberg)
/   - childOrder table: Child slices generated by algo engine
/   - executionBenchmark table: Benchmark prices for TCA (arrival, VWAP)
/ ----------------------------------------------------------------------------
/ Dependencies:
/   - types.q (validation, constants)
/ ----------------------------------------------------------------------------
/ Tables:
/   - algoOrder: keyed by algoOrderId
/   - childOrder: keyed by childOrderId, FK to algoOrderId
/   - executionBenchmark: keyed by time, exchange, pair
/ ============================================================================

\d .algo

// ============================================================================
// ALGO ORDER TABLE SCHEMA
// ============================================================================

/ Parent algo order schema
algoOrderSchema:([]
  algoOrderId:`symbol$();                  / Unique algo order ID (PK)
  exchange:`symbol$();                     / Exchange name
  pair:`symbol$();                         / Trading pair
  side:`symbol$();                         / `buy or `sell
  targetQty:`long$();                      / Total target quantity (fixed precision)
  filledQty:`long$();                      / Quantity filled so far
  algo:`symbol$();                         / Algorithm type (`vwap`twap`iceberg)
  algoParams:();                           / Algorithm parameters (dict)
  benchmark:`symbol$();                    / Benchmark type (`arrival`vwap)
  benchmarkPrice:`long$();                 / Benchmark price for TCA (null until set)
  status:`symbol$();                       / `active`paused`cancelled`completed
  startTime:`timestamp$();                 / Algorithm start time
  endTime:`timestamp$();                   / Algorithm end time (null for no limit)
  createdAt:`timestamp$();                 / Order creation timestamp
  completedAt:`timestamp$()                / Completion timestamp (null if incomplete)
 );

/ Initialize algoOrder table
initAlgoOrderTable:{[]
  algoOrder::`algoOrderId xkey algoOrderSchema;
 };

// ============================================================================
// CHILD ORDER TABLE SCHEMA
// ============================================================================

/ Child order slice schema
childOrderSchema:([]
  childOrderId:`symbol$();                 / Unique child order ID (PK)
  algoOrderId:`symbol$();                  / Parent algo order ID (FK)
  exchange:`symbol$();                     / Exchange name
  pair:`symbol$();                         / Trading pair
  side:`symbol$();                         / `buy or `sell
  orderType:`symbol$();                    / Order type (`market`limit)
  price:`long$();                          / Order price (null for market)
  quantity:`long$();                       / Order quantity (fixed precision)
  filledQty:`long$();                      / Quantity filled
  status:`symbol$();                       / Order status
  submitTime:`timestamp$();                / Submission timestamp
  fillTime:`timestamp$();                  / Fill timestamp (null if not filled)
  avgFillPrice:`long$()                    / Average fill price (null until filled)
 );

/ Initialize childOrder table
initChildOrderTable:{[]
  childOrder::`childOrderId xkey childOrderSchema;
 };

// ============================================================================
// EXECUTION BENCHMARK TABLE SCHEMA
// ============================================================================

/ Benchmark price tracking for TCA
executionBenchmarkSchema:([]
  time:`timestamp$();                      / Timestamp (PK component)
  exchange:`symbol$();                     / Exchange name (PK component)
  pair:`symbol$();                         / Trading pair (PK component)
  benchmarkType:`symbol$();                / Benchmark type (`arrival`vwap`mid`last)
  price:`long$();                          / Benchmark price (fixed precision)
  volume:`long$()                          / Volume (for VWAP calculation)
 );

/ Initialize executionBenchmark table
initExecutionBenchmarkTable:{[]
  executionBenchmark::`time`exchange`pair xkey executionBenchmarkSchema;
 };

// ============================================================================
// TABLE INITIALIZATION
// ============================================================================

/ Initialize all algo tables
init:{[]
  initAlgoOrderTable[];
  initChildOrderTable[];
  initExecutionBenchmarkTable[];

  -1 "  Algo schemas initialized: algoOrder, childOrder, executionBenchmark";

  1b
 };

// ============================================================================
// VALIDATION FUNCTIONS
// ============================================================================

/ Valid algorithm types
ALGO_TYPES:`vwap`twap`iceberg;

/ Valid benchmark types
BENCHMARK_TYPES:`arrival`vwap`mid`last;

/ Valid algo order statuses
ALGO_STATUS:`active`paused`cancelled`completed;

/ Validate algorithm type
isValidAlgoType:{[algo]
  algo in ALGO_TYPES
 };

/ Validate benchmark type
isValidBenchmarkType:{[benchmark]
  benchmark in BENCHMARK_TYPES
 };

/ Validate algo order status
isValidAlgoStatus:{[status]
  status in ALGO_STATUS
 };

\d .

/ Export namespace
-1 "  Algo schemas loaded: .algo namespace with algoOrder, childOrder, executionBenchmark";
