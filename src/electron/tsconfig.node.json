{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist-electron",
    "baseUrl": ".",
    "paths": {
      "@main/*": ["./main/*"]
    },
    "types": ["node"]
  },
  "include": ["main/**/*", "electron.vite.config.ts"]
}
